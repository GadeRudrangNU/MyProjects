{
  "ShipSafe": {
    "AdminKey": "dev-admin-key",
    "SdkKey": "dev-sdk-key",
    "Database": "Data Source=shipsafe.db",
    "SeedDemo": true,
    "MonitorIntervalMs": 500
  },
  "Telemetry": {
    "Console": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Urls": "http://localhost:5080",
  "AllowedHosts": "*"
}
