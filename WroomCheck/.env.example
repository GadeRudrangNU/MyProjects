# Postgres + pgvector (docker compose up -d db)
DATABASE_URL=postgresql://wroom:wroom@localhost:5433/wroomcheck

# "minilm" = sentence-transformers all-MiniLM-L6-v2 (free, local, recommended for real data)
# "hashing" = dependency-free hashed bag-of-words (used by the demo and tests)
WROOM_EMBEDDER=minilm

# "ollama" = free local LLM via Ollama (install from ollama.com, then `ollama pull llama3.2:3b`)
# "none"   = deterministic extractive summaries (always grounded, no LLM needed)
WROOM_LLM=none
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434
