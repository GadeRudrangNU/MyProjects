# Copy to .env (never commit .env). All AI calls happen server-side; the key never reaches the browser.

# gemini = use Gemini for tailoring/drafts when a key is present; local = never call an external API
AI_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Hard cap on Gemini requests per day (cached results are free and do not count)
AI_DAILY_REQUEST_LIMIT=40

# auto = sentence-transformers if installed/downloadable, else TF-IDF fallback; or force: tfidf
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: point at a different SQLite file (e.g. the demo database)
# DATABASE_URL=sqlite:///data/demo.db
# Shows a "synthetic demo data" banner in the UI
# DEMO_DATA=1

# Analytics thresholds
MIN_APPLICATIONS_FOR_RATES=5
TIME_CLAIM_THRESHOLD=10
HIGH_MATCH_THRESHOLD=70
