    {
      "id": 13,
      "type": "timeseries",
      "title": "Idempotent replays and rejected overdrafts",
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(payflow_idempotent_replays_total[1m])",
          "legendFormat": "idempotent replays/s",
          "datasource": {
