# Copy to .env (never commit .env). No API keys are required anywhere in FeaturePulse.

# PostgreSQL with pgvector. Leave commented to use the embedded database under data/pgdata.
# DATABASE_URL=postgresql://featurepulse:featurepulse@localhost:5432/featurepulse

# Optional: relocate the embedded database
# FEATUREPULSE_PGDATA=./data/pgdata

# Optional: Hugging Face token (only raises download rate limits for the public embedding model)
# HF_TOKEN=
