{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter @bytedrop/shared build",
  "buildCommand": "NEXT_PUBLIC_DEMO=1 pnpm exec next build",
  "headers": [
    {
      "source": "/mockServiceWorker.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }]
    }
  ]
}
