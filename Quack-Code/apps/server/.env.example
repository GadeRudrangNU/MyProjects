# Leave DATABASE_URL empty in development to use the local embedded Postgres.
DATABASE_URL=
PORT=4000
WEB_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:4000
# Create a free OAuth app at github.com/settings/developers (callback: PUBLIC_URL/api/v1/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DEV_LOGIN=true
